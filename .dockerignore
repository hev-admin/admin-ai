# 依赖与产物：镜像内重新安装/生成
node_modules
**/node_modules
apps/web/dist
apps/server/generated
apps/docs/.vitepress/cache
apps/docs/.vitepress/dist

# 本地数据与密钥：严禁进镜像
apps/server/data
.env
**/.env
**/.env.*
!**/.env.example

# docs 内容不进镜像，但保留 package.json 维持 lockfile importers 一致（--frozen-lockfile）
apps/docs/*
!apps/docs/package.json

# 版本库与工程外围
.git
.github
.vscode
.claude
reports
*.md
