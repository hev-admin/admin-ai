# 服务端口
PORT=3000

# JWT 密钥与过期时间（过期时间支持 s/m/h/d 单位，纯数字按秒）
JWT_SECRET=please-change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# 数据驱动：prisma（关系库，默认）| mongo
DB_DRIVER=prisma

# 关系库连接（SQLite 相对路径相对 apps/server 目录解析）
DATABASE_URL="file:./data/app.db"

# MongoDB 连接（DB_DRIVER=mongo 时生效，M4 启用）
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB=admin_ai

# 出站请求适配器：fetch（默认）| axios
HTTP_ADAPTER=fetch

# 日志级别：debug | info（默认）| warn | error（结构化 JSON 行输出，含请求 id）
LOG_LEVEL=info

# 登录限流（进程内存实现，单实例语义）：窗口内失败达阈值后 429（可缺省）
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW=15m

# web 静态托管（单镜像部署形态，M7）：指向 web 构建产物目录（绝对路径）后，
# server 同源托管页面与 /api，并对非 /api 未匹配路径回退 index.html（SPA 路由）。
# 本地开发不设置（web 由 Vite dev server 服务）。
# WEB_DIST=/app/web-dist
